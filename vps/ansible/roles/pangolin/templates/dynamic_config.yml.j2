# Temporary static route for Pangolin initial setup
http:
  routers:
    pangolin-setup:
      rule: "PathPrefix(`/`)"
      entryPoints:
        - websecure
      service: pangolin-frontend
      tls:
        certResolver: letsencrypt

  services:
    pangolin-frontend:
      loadBalancer:
        servers:
          - url: "http://pangolin:3002"