#!/usr/bin/env bash
# Managed by Ansible (vps/ansible/roles/crowdsec) -- do not edit on the host.
#
# Keeps a CrowdSec allowlist pointed at the home network's current public IP, so
# the operator is never banned by their own traffic.
#
# The home IP is dynamic, and it is read from the WireGuard peer endpoint rather
# than from a DDNS record or an echo service: the tunnel re-handshakes from the
# new address within seconds of an ISP change, so this host already knows the
# answer, and it is by construction the same address CrowdSec is judging.
#
# The allowlist itself is the source of truth for what needs doing, so a lost
# state file, a hand-edited entry or a half-finished previous run all converge on
# the next pass.

set -euo pipefail

ALLOWLIST={{ crowdsec_home_allowlist_name | quote }}
WG_IFACE={{ crowdsec_home_allowlist_wg_interface | quote }}
WG_PEER={{ crowdsec_home_allowlist_wg_peer | quote }}
EXPIRATION={{ crowdsec_home_allowlist_expiration | quote }}
RENEW_BEFORE_SECONDS={{ crowdsec_home_allowlist_renew_before_seconds }}
COMMENT="home network (managed by Ansible)"

log() { printf '%s %s\n' "$(date -Is)" "$*"; }

# Every lookup failure leaves the current entry in place instead of withdrawing
# it. Removing the allowlist entry on a transient error is precisely how the
# operator would get locked out; a genuinely stale entry ages out via EXPIRATION.
skip() { log "$*"; exit 0; }

is_public_ip() {
    local ip=$1 a b

    case $ip in
        *:*)
            case ${ip,,} in
                ::1 | fe80:* | fc* | fd*) return 1 ;;
                *) return 0 ;;
            esac
            ;;
    esac

    [[ $ip =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    a=${BASH_REMATCH[1]}
    b=${BASH_REMATCH[2]}
    ((a <= 255 && b <= 255 && BASH_REMATCH[3] <= 255 && BASH_REMATCH[4] <= 255)) || return 1

    case $a in
        0 | 10 | 127) return 1 ;;
        100) ((b >= 64 && b <= 127)) && return 1 ;;
        169) ((b == 254)) && return 1 ;;
        172) ((b >= 16 && b <= 31)) && return 1 ;;
        192) ((b == 168)) && return 1 ;;
    esac
    ((a >= 224)) && return 1

    return 0
}

command -v wg >/dev/null 2>&1 || skip "wireguard-tools is not installed; nothing to read"

if [[ -n $WG_IFACE ]]; then
    iface=$WG_IFACE
else
    read -r -a ifaces <<<"$(wg show interfaces 2>/dev/null || true)"
    ((${#ifaces[@]} == 1)) ||
        skip "expected exactly one WireGuard interface, found ${#ifaces[@]}; set crowdsec_home_allowlist_wg_interface"
    iface=${ifaces[0]}
fi

endpoints=$(wg show "$iface" endpoints 2>/dev/null || true)
[[ -n $endpoints ]] || skip "no peers on $iface"

# Selecting the wrong peer would allowlist a stranger, so an ambiguous tunnel is
# a hard stop rather than a guess.
if [[ -n $WG_PEER ]]; then
    endpoint=$(awk -v peer="$WG_PEER" '$1 == peer { print $2 }' <<<"$endpoints")
    [[ -n $endpoint ]] || skip "peer $WG_PEER not found on $iface"
else
    peer_count=$(grep -c . <<<"$endpoints")
    ((peer_count == 1)) ||
        skip "$iface has $peer_count peers; set crowdsec_home_allowlist_wg_peer to pick one"
    endpoint=$(awk '{ print $2 }' <<<"$endpoints")
fi

# "(none)" until the peer has handshaked at least once.
case $endpoint in
    \[*\]:*)
        ip=${endpoint%]*}
        ip=${ip#[}
        ;;
    *:*) ip=${endpoint%:*} ;;
    *) skip "peer endpoint is '$endpoint'; no address yet" ;;
esac

is_public_ip "$ip" || skip "peer endpoint $ip is not a public address; refusing to allowlist it"

# Compare against what the allowlist actually holds. Anything that is not the
# current endpoint is reported as STALE; the verdict says whether the wanted
# entry is present with enough time left on it.
inspect=$(cscli allowlists inspect "$ALLOWLIST" -o json 2>/dev/null) ||
    skip "cannot read allowlist $ALLOWLIST"

plan=$(
    ALLOWLIST_JSON="$inspect" python3 - "$ip" "$RENEW_BEFORE_SECONDS" <<'PY' || true
import datetime
import json
import os
import sys

wanted, renew_before = sys.argv[1], int(sys.argv[2])
try:
    items = json.loads(os.environ["ALLOWLIST_JSON"]).get("items") or []
except ValueError:
    sys.exit(1)

now = datetime.datetime.now(datetime.timezone.utc)
fresh = False
for item in items:
    value = item.get("value")
    if value != wanted:
        print("STALE", value)
        continue
    expiration = item.get("expiration")
    if not expiration:
        fresh = True
        continue
    try:
        expires = datetime.datetime.fromisoformat(expiration.replace("Z", "+00:00"))
    except ValueError:
        continue
    fresh = (expires - now).total_seconds() > renew_before

print("FRESH" if fresh else "RENEW")
PY
)
[[ -n $plan ]] || skip "could not parse allowlist $ALLOWLIST"

while read -r verdict value; do
    [[ $verdict == STALE ]] || continue
    log "removing stale entry $value from $ALLOWLIST"
    cscli allowlists remove "$ALLOWLIST" "$value" >/dev/null 2>&1 || true
done <<<"$plan"

grep -q '^FRESH$' <<<"$plan" && exit 0

# `add` treats a value already present as a no-op and still exits 0, so it will
# never extend an expiry -- renewing has to remove the entry first. A failure
# between the two leaves a gap that the next run closes, which is why the timer
# interval is short.
cscli allowlists remove "$ALLOWLIST" "$ip" >/dev/null 2>&1 || true
cscli allowlists add "$ALLOWLIST" "$ip" -e "$EXPIRATION" -d "$COMMENT" >/dev/null ||
    skip "could not add $ip to allowlist $ALLOWLIST; will retry on the next run"

# An allowlist stops new decisions but does not retract one already handed to the
# firewall bouncer, so a ban taken in the window before this ran is cleared here.
# This is what makes an IP change that races a ban self-healing.
cscli decisions delete --ip "$ip" >/dev/null 2>&1 || true

log "allowlisted $ip in $ALLOWLIST (expires in $EXPIRATION)"
