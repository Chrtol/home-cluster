# Extract trace ID from traceparent header for logging
# Format: version-trace_id-parent_id-trace_flags
map $http_traceparent $trace_id {
    ~^[0-9a-f]{2}-([0-9a-f]{32})-[0-9a-f]{16}-[0-9a-f]{2}$ $1;
    default "-";
}

# Custom log format with trace correlation
log_format trace_format '$remote_addr - $remote_user [$time_local] '
                        '"$request" $status $body_bytes_sent '
                        '"$http_referer" "$http_user_agent" '
                        'trace_id=$trace_id '
                        'request_time=$request_time '
                        'upstream_response_time=$upstream_response_time '
                        'upstream_addr=$upstream_addr '
                        'host=$host';

# WebSocket Connection Upgrade Map
# If client sends Upgrade header → Connection: upgrade (for WebSockets)
# If no Upgrade header → Connection: close (for regular HTTP)
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Redirect HTTP to HTTPS
server {
    listen 80;
    server_name *.{{ nginx_domain }} {{ nginx_domain }};
    return 301 https://$host$request_uri;
}

{% if enable_echo_test is defined and enable_echo_test %}
# Echo test server for Envoy Gateway testing
server {
    listen 443 ssl http2;
    server_name echo-test.{{ nginx_domain }};

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # SSL certificate
    ssl_certificate {{ nginx_ssl_cert_path }};
    ssl_certificate_key {{ nginx_ssl_key_path }};

    # SSL settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    location / {
        set $envoy_backend "{{ nginx_envoy_gateway_ip }}";

        proxy_pass http://$envoy_backend:80;
        proxy_http_version 1.1;

        # Proxy settings
        proxy_buffering off;
        proxy_request_buffering off;

        # Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;

        # File upload
        client_max_body_size 100M;
        client_body_buffer_size 1M;
    }
}
{% endif %}

# Main wildcard server for all services
server {
    listen 443 ssl http2;
    server_name *.{{ nginx_domain }} {{ nginx_domain }};

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # SSL certificate
    ssl_certificate {{ nginx_ssl_cert_path }};
    ssl_certificate_key {{ nginx_ssl_key_path }};

    # SSL settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Large file upload and streaming
    client_max_body_size 100M;
    client_body_buffer_size 1M;
    client_body_timeout 120s;

    # Enable trace-aware access logging
    access_log /var/log/nginx/access-trace.log trace_format;

    location / {
        # Proxy to home cluster external nginx-ingress via WireGuard
        proxy_pass https://{{ nginx_external_ingress_ip }}:443;
        proxy_http_version 1.1;

        # SSL proxy settings
        proxy_ssl_verify off;           # Backend uses self-signed cert, already secure via WireGuard
        proxy_ssl_session_reuse on;     # Reduce SSL handshake overhead
        proxy_ssl_protocols TLSv1.2 TLSv1.3;

        # Buffering settings - critical for streaming
        proxy_buffering off;            # Don't buffer responses (essential for Plex streaming)
        proxy_request_buffering off;    # Don't buffer requests (fixes upload timeouts)

        # Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;

        # WebSocket support - FIXED: Was using non-existent $http_connection variable
        # Now properly uses the connection_upgrade map defined at top of file
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Extended timeouts for streaming
        proxy_connect_timeout 60s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
        send_timeout 3600s;

        # Keep socket alive for better performance
        proxy_socket_keepalive on;

        # TCP optimizations
        tcp_nodelay on;
        tcp_nopush on;

        # Pass OpenTelemetry trace context headers for correlation
        proxy_set_header traceparent $http_traceparent;
        proxy_set_header tracestate $http_tracestate;
        proxy_set_header baggage $http_baggage;
    }

{% if enable_metrics is defined and enable_metrics %}
    location /metrics/node {
        auth_basic "Metrics Access";
        auth_basic_user_file /etc/nginx/.htpasswd;
        proxy_pass http://localhost:9100/metrics;
    }

    location /metrics/wireguard {
        auth_basic "Metrics Access";
        auth_basic_user_file /etc/nginx/.htpasswd;
        proxy_pass http://localhost:9586/metrics;
    }
{% endif %}
}