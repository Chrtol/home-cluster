#!/bin/sh
{% raw %}
# Dead-man's-switch watcher (POSIX sh, BusyBox-compatible).
#
# Two concurrent responsibilities:
#   1. HTTP listener: on GET /ping/<token>, touch the heartbeat file (reset timer).
#   2. Staleness loop: if the heartbeat file is older than the grace period,
#      send a Pushover notification that the cluster heartbeat has stopped.
#
# Rendered by Ansible; all config injected as env vars via docker-compose.
# No secrets are baked into this file.

set -eu

HEARTBEAT_FILE="/data/last_ping"
STATE_FILE="/data/state"          # "up" or "down" — tracks last known heartbeat state
LAST_NOTIFY_FILE="/data/last_notify"

PORT="${DEADMAN_PORT:-9720}"
TOKEN="${DEADMAN_TOKEN:?token required}"
GRACE="${DEADMAN_GRACE_SECONDS:-600}"
CHECK_INTERVAL="${DEADMAN_CHECK_INTERVAL:-60}"
RENOTIFY="${DEADMAN_RENOTIFY_SECONDS:-3600}"
PUSHOVER_TOKEN="${DEADMAN_PUSHOVER_TOKEN:?pushover token required}"
PUSHOVER_USER="${DEADMAN_PUSHOVER_USER:?pushover user required}"
PUSHOVER_PRIORITY="${DEADMAN_PUSHOVER_PRIORITY:-1}"

log() { echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') $*"; }

# Seed the heartbeat so a fresh start does not immediately alarm.
[ -f "$HEARTBEAT_FILE" ] || touch "$HEARTBEAT_FILE"
[ -f "$STATE_FILE" ] || echo "up" > "$STATE_FILE"

send_pushover() {
  # $1 = title, $2 = message
  curl -sS --max-time 15 \
    --form-string "token=${PUSHOVER_TOKEN}" \
    --form-string "user=${PUSHOVER_USER}" \
    --form-string "priority=${PUSHOVER_PRIORITY}" \
    --form-string "title=$1" \
    --form-string "message=$2" \
    https://api.pushover.net/1/messages.json >/dev/null 2>&1 \
    && log "pushover sent: $1" \
    || log "ERROR pushover send failed: $1"
}

# ---- Staleness loop (background) ----
staleness_loop() {
  while true; do
    now="$(date +%s)"
    last="$(stat -c %Y "$HEARTBEAT_FILE" 2>/dev/null || echo 0)"
    age=$(( now - last ))
    state="$(cat "$STATE_FILE" 2>/dev/null || echo up)"

    if [ "$age" -gt "$GRACE" ]; then
      # Heartbeat is stale → cluster monitoring is dark.
      last_notify="$(cat "$LAST_NOTIFY_FILE" 2>/dev/null || echo 0)"
      since_notify=$(( now - last_notify ))
      if [ "$state" != "down" ] || { [ "$RENOTIFY" -gt 0 ] && [ "$since_notify" -ge "$RENOTIFY" ]; }; then
        send_pushover "🔴 Cluster heartbeat LOST" \
          "No Alertmanager heartbeat for ${age}s (grace ${GRACE}s). Cluster/ingress or monitoring may be down. This is the out-of-cluster dead-man's-switch on the VPS."
        echo "$now" > "$LAST_NOTIFY_FILE"
      fi
      echo "down" > "$STATE_FILE"
    else
      # Heartbeat healthy → send a recovery note if we were previously down.
      if [ "$state" = "down" ]; then
        send_pushover "🟢 Cluster heartbeat RECOVERED" \
          "Alertmanager heartbeat is arriving again (last ping ${age}s ago)."
      fi
      echo "up" > "$STATE_FILE"
    fi
    sleep "$CHECK_INTERVAL"
  done
}

# ---- HTTP listener ----
# Minimal HTTP/1.0 handler via BusyBox nc + a FIFO. This pattern avoids relying
# on `nc -e` (absent in some BusyBox builds): the request flows in on stdin, and
# the handler's response is fed back into nc through the FIFO.
#
# Each accepted connection is handled synchronously. A dead-man's-switch takes a
# ping roughly every couple of minutes, so single-threaded accept is ample.
REQ_FIFO="/tmp/deadman.fifo"

build_response() {
  # Reads the request line from stdin, writes the raw HTTP response to stdout.
  read -r method path _ || return 0
  # Strip trailing CR that HTTP clients send on the request line.
  path="${path%$(printf '\r')}"
  case "$method $path" in
    "GET /ping/$TOKEN"|"GET /ping/$TOKEN/")
      touch "$HEARTBEAT_FILE"
      body="ok"
      ;;
    "GET /healthz")
      body="alive"
      ;;
    *)
      printf 'HTTP/1.0 404 Not Found\r\nContent-Type: text/plain\r\nContent-Length: 9\r\nConnection: close\r\n\r\nnot found'
      return 0
      ;;
  esac
  printf 'HTTP/1.0 200 OK\r\nContent-Type: text/plain\r\nContent-Length: %s\r\nConnection: close\r\n\r\n%s' "${#body}" "$body"
}

listener_loop() {
  rm -f "$REQ_FIFO"
  mkfifo "$REQ_FIFO"
  while true; do
    # nc reads the response from the FIFO and writes the request to build_response.
    # build_response consumes the request line and writes its response into the FIFO.
    build_response < "$REQ_FIFO" | nc -l -p "$PORT" > "$REQ_FIFO" 2>/dev/null || true
  done
}

log "deadman watcher starting: port=$PORT grace=${GRACE}s check=${CHECK_INTERVAL}s"
staleness_loop &
listener_loop
{% endraw %}
