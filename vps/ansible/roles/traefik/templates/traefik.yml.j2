# Traefik Static Configuration
api:
  dashboard: true
  debug: false

# Entry Points
entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entrypoint:
          to: websecure
          scheme: https
          permanent: true

  websecure:
    address: ":443"
    http2:
      maxConcurrentStreams: 250
    http3:
      advertisedPort: 443

  metrics:
    address: ":8082"

# Providers
providers:
  file:
    filename: /etc/traefik/dynamic.yml
    watch: true

{% if traefik_crowdsec_enabled | default(true) %}
# CrowdSec Plugin Configuration
experimental:
  plugins:
    crowdsec-bouncer-traefik-plugin:
      moduleName: github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin
      version: v1.3.5

# CrowdSec Plugin Static Configuration
plugin:
  crowdsec-bouncer-traefik-plugin:
    enabled: true
    logLevel: {{ traefik_crowdsec_log_level | default('INFO') }}
    crowdsecLapiKey: {{ traefik_crowdsec_api_key | default('${CROWDSEC_BOUNCER_API_KEY}') }}
    crowdsecLapiHost: {{ traefik_crowdsec_lapi_host | default('127.0.0.1:8080') }}
    crowdsecLapiScheme: http
    crowdsecMode: stream
    updateIntervalSeconds: 10
    defaultDecisionSeconds: 60
    httpTimeoutSeconds: 10
    crowdsecCapiMachineId: ""
    crowdsecCapiPassword: ""
    crowdsecCapiScenarios: []
    forwardedHeadersCustomName: ""
    redisCacheEnabled: false
    crowdsecLapiTlsInsecureVerify: true
    crowdsecAppsecEnabled: false
{% endif %}

# Using existing certificates from 1Password configuration
# No ACME/Let's Encrypt needed since certificates already exist

# OpenTelemetry Tracing Configuration (OTLP format for Traefik v3)
tracing:
  serviceName: {{ traefik_service_name | default('vps-traefik') }}
  sampleRate: {{ traefik_sample_rate | default('0.75') }}
  otlp:
    grpc:
      endpoint: {{ traefik_otel_endpoint }}
      insecure: {{ traefik_otel_insecure | default('false') }}
      headers:
        # Optional: Add any auth headers if needed
        # authorization: Bearer ${OTEL_AUTH_TOKEN}

# Logs - output to stdout/stderr for docker logs
log:
  level: {{ traefik_log_level | default('INFO') }}
  # No filePath means output to stdout

# Access log to file for debugging (separate from stdout)
accessLog:
  filePath: /logs/access.log
  format: json
  fields:
    defaultMode: keep
    headers:
      defaultMode: drop
      names:
        User-Agent: keep
        Authorization: drop
        Cookie: drop

# Health Check
ping:
  entryPoint: web

# Metrics (Prometheus)
metrics:
  prometheus:
    addEntryPointsLabels: true
    addRoutersLabels: true
    addServicesLabels: true
    entryPoint: metrics