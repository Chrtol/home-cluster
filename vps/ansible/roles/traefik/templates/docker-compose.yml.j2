services:
  traefik:
    # renovate: datasource=docker depName=traefik
    image: docker.io/library/traefik:v3.7.17
    container_name: traefik
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    network_mode: host  # Use host network for ports 80/443
    volumes:
      # The directory, not the two files: a template write replaces dynamic.yml,
      # and only a directory mount lets the running Traefik see the new file
      - {{ traefik_config_dir }}:/etc/traefik:ro

      # Access log, read by CrowdSec on the host
      - {{ traefik_access_log_dir }}:{{ traefik_access_log_dir }}

      # Mount existing SSL certificates (read-only)
      - {{ proxy_ssl_cert_path }}:{{ proxy_ssl_cert_path }}:ro
      - {{ proxy_ssl_key_path }}:{{ proxy_ssl_key_path }}:ro

{% if traefik_enable_metrics | default(false) %}
  node-exporter:
    # renovate: datasource=docker depName=quay.io/prometheus/node-exporter
    image: quay.io/prometheus/node-exporter:v1.12.1
    container_name: node-exporter
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    network_mode: host
    pid: host
    command:
      - '--path.rootfs=/host'
      - '--web.listen-address=:9100'
    volumes:
      - /:/host:ro,rslave
{% endif %}