services:
  traefik:
    image: traefik:v3.3
    container_name: traefik
    restart: unless-stopped
    network_mode: host  # Use host network for ports 80/443
    # No environment variables needed - using existing certificates
    volumes:
      # Configuration files
      - {{ traefik_dir }}/config/traefik.yml:/etc/traefik/traefik.yml:ro
      - {{ traefik_dir }}/config/dynamic.yml:/etc/traefik/dynamic.yml:ro

      # Mount existing SSL certificates (read-only)
      - {{ proxy_ssl_cert_path }}:{{ proxy_ssl_cert_path }}:ro
      - {{ proxy_ssl_key_path }}:{{ proxy_ssl_key_path }}:ro

      # Logs
      - {{ traefik_dir }}/logs:/logs