    {
      "id": 10,
      "type": "timeseries",
      "title": "middlewared RSS \u2014 the leak",
      "description": "THE panel. middlewared leaks memory (~485 MB baseline). Left alone it reached 13.2 GB of 16 GB over 54 days and the kernel OOM-killed nginx (2026-07-13 03:07). A weekly cron restarts it Sunday 05:00 if it is over 2 GB \u2014 expect a sawtooth. A straight climb through the thresholds means the restart is not keeping up.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "namedprocess_namegroup_memory_bytes{job=\"nas-process-exporter\",groupname=\"middlewared\",memtype=\"resident\"}",
          "legendFormat": "middlewared RSS",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "4e9",
          "legendFormat": "warning threshold (4 GB)",
          "range": true,
          "instant": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "8e9",
          "legendFormat": "critical threshold (8 GB)",
          "range": true,
          "instant": false,
          "refId": "C"
        }
      ],
      "options": {
        "legend": {
          "calcs": [
            "last",
            "max",
            "mean"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "axisPlacement": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 4000000000.0
              },
              {
                "color": "red",
                "value": 8000000000.0
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "middlewared growth rate (per day)",
      "description": "Leak rate, extrapolated to bytes/day from a 6h window. The original estimate (~235 MB/day) was derived from a single before/after measurement, NOT an observed slope \u2014 this panel is the real answer. Sustained values well above ~235 MB/day mean the cron threshold and the 8 GB alert need retuning.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "deriv(namedprocess_namegroup_memory_bytes{job=\"nas-process-exporter\",groupname=\"middlewared\",memtype=\"resident\"}[6h]) * 86400",
          "legendFormat": "bytes/day",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "calcs": [
            "last",
            "max"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "never",
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "axisPlacement": "auto"
          },
          "thresholds": {
