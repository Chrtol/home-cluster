    {
      "id": 19,
      "type": "timeseries",
      "title": "ARC hit rate over time",
      "description": "IS THE L2ARC WORTH IT? At time of writing ARC was at 98.5% hit rate while L2ARC managed only ~34% while caching 427 GB. L2ARC lookup headers consume RAM \u2014 on a 16 GB box that may be stealing from the ARC doing the real work. If L2ARC hit rate stays poor, consider removing the cache device (nvme1n1) and giving the RAM back to ARC.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * rate(node_zfs_arc_hits{job=\"nas-node-exporter\"}[10m]) / (rate(node_zfs_arc_hits{job=\"nas-node-exporter\"}[10m]) + rate(node_zfs_arc_misses{job=\"nas-node-exporter\"}[10m]))",
          "legendFormat": "ARC hit %",
