      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(\n  last_over_time(up{job=\"speedtest-exporter\"}[2h])\n  and on (pod) topk(1, max by (pod) (last_over_time(timestamp(up{job=\"speedtest-exporter\"})[2h:1m])))\n)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Exporter",
      "type": "stat"
    },
    {
