            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Exporter scraped" },
            "properties": [
              {
                "id": "mappings",
                "value": [
