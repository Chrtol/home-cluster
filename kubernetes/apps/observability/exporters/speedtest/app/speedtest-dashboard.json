    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "One block per hour (wider when zoomed out). Red means at least one test in the block failed. An empty block means no scrape happened.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "fillOpacity": 85, "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineWidth": 1 },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "color": "red", "index": 1, "text": "Failed" },
                "1": { "color": "green", "index": 0, "text": "Passed" }
