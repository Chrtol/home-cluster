{
  "embeds": [{
    "title": "🚨 Alert: {{ $json.alert.name }}",
    "description": "{{ $json.alert.summary }}",
    "color": 16776960,
    "timestamp": "{{ $now }}",
    "fields": [
      {
        "name": "Severity",
        "value": "{{ $json.alert.severity }}",
        "inline": true
      },
      {
        "name": "Namespace", 
        "value": "{{ $json.alert.namespace }}",
        "inline": true
      },
      {
        "name": "Status",
        "value": "{{ $json.alert.status }}",
        "inline": true
      },
      {
        "name": "Resource",
        "value": "{{ $json.alert.service_name || $json.labels.horizontalpodautoscaler || $json.labels.deployment || $json.labels.statefulset || $json.labels.job_name || $json.labels.daemonset || $json.labels.instance || $json.labels.cluster_name || 'Unknown' }}",
        "inline": true
      },
      {
        "name": "{{ $json.labels.horizontalpodautoscaler ? 'Target' : ($json.alert.name.includes('Pod') || $json.alert.name.includes('Container') ? 'Pod' : ($json.alert.group ? 'Group' : 'Type')) }}",
        "value": "{{ $json.labels.horizontalpodautoscaler ? ($json.labels.scaletargetkind || 'Deployment') + '/' + ($json.labels.scaletargetname || $json.labels.horizontalpodautoscaler) : ($json.alert.name.includes('Pod') || $json.alert.name.includes('Container') ? ($json.labels.pod || 'N/A') : ($json.alert.group || ($json.labels.deployment ? 'Deployment' : ($json.labels.statefulset ? 'StatefulSet' : ($json.labels.job_name ? 'Job' : ($json.labels.daemonset ? 'DaemonSet' : 'N/A')))))) }}",
        "inline": true
      },
      {
        "name": "{{ $json.labels.horizontalpodautoscaler ? 'Current/Max Replicas' : ($json.alert.name.includes('Container') ? 'Container' : 'Details') }}",
        "value": "{{ $json.labels.horizontalpodautoscaler ? ($json.labels.current_replicas || 'N/A') + '/' + ($json.labels.max_replicas || 'N/A') : ($json.alert.name.includes('Container') ? ($json.labels.container || 'N/A') : ($json.labels.reason || $json.labels.condition || 'See description')) }}",
        "inline": true
      },
      {
        "name": "Routing Decision",
        "value": "{{ $json.routing_context.routing_reason }}",
        "inline": false
      },
      {
        "name": "Source",
        "value": "{{ $json.alert.gatus_instance ? 'Gatus (' + $json.alert.gatus_instance + ')' : ($json.source || 'Alertmanager') }}",
        "inline": true
      }
    ],
    "footer": {
      "text": "Home Lab Alert"
    }
  }]
}