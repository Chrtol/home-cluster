{
  "embeds": [{
    "title": "🚨 Alert: {{ $json.alert.name }}",
    "description": "{{ $json.alert.summary }}",
    "color": 16776960,
    "timestamp": "{{ $now }}",
    "fields": [
      {
        "name": "Severity",
        "value": "{{ $json.alert.severity }}",
        "inline": true
      },
      {
        "name": "Namespace", 
        "value": "{{ $json.alert.namespace }}",
        "inline": true
      },
      {
        "name": "Status",
        "value": "{{ $json.alert.status }}",
        "inline": true
      },
      {
        "name": "Resource",
        "value": "{{ $json.labels.horizontalpodautoscaler || $json.labels.deployment || $json.labels.statefulset || $json.labels.job || 'Unknown' }}",
        "inline": true
      },
      {
        "name": "{{ $json.labels.horizontalpodautoscaler ? 'Target' : 'Pod' }}",
        "value": "{{ $json.labels.horizontalpodautoscaler ? ($json.labels.scaletargetkind || 'Deployment') + '/' + ($json.labels.scaletargetname || $json.labels.horizontalpodautoscaler) : ($json.labels.pod || 'N/A') }}",
        "inline": true
      },
      {
        "name": "{{ $json.labels.horizontalpodautoscaler ? 'Current/Max Replicas' : 'Container' }}",
        "value": "{{ $json.labels.horizontalpodautoscaler ? ($json.labels.current_replicas || 'N/A') + '/' + ($json.labels.max_replicas || 'N/A') : ($json.labels.container || 'N/A') }}",
        "inline": true
      },
      {
        "name": "Routing Decision",
        "value": "{{ $json.routing_context.routing_reason }}",
        "inline": false
      }
    ],
    "footer": {
      "text": "Home Lab Alert"
    }
  }]
}