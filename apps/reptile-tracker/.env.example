# H-2 Security Fix: Required secrets must be provided via environment variables
# Copy this file to .env and fill in your values

# REQUIRED: Generate a secure random secret key (e.g., openssl rand -hex 32)
SECRET_KEY=your_secure_secret_key_here_use_openssl_rand_hex_32

# REQUIRED: Your Authentik OIDC client secret
OIDC_CLIENT_SECRET=your_authentik_client_secret

# Optional: Override defaults
POSTGRES_PASSWORD=choose_secure_database_password
OIDC_CLIENT_ID=reptile-tracker
OIDC_DISCOVERY_URL=https://your-authentik-domain.com/application/o/reptile-tracker/.well-known/openid-configuration
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
FRONTEND_URL=http://localhost:3000
WEBHOOK_URL=

# Generate secure secrets with:
# SECRET_KEY: openssl rand -hex 32
# POSTGRES_PASSWORD: openssl rand -base64 32
