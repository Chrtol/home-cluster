# Development Environment Configuration
# Copy this file to .env for local development
# With the defaults below, you can run `docker compose up` immediately

# Database (default works with docker-compose postgres service)
POSTGRES_PASSWORD=dev_password

# Security - CHANGE THESE FOR PRODUCTION
# Generate with: openssl rand -hex 32
SECRET_KEY=dev_secret_key_DO_NOT_USE_IN_PRODUCTION

# OIDC - Not used when ENVIRONMENT=development (auth bypass active)
# These are placeholder values that satisfy config validation
OIDC_CLIENT_ID=reptile-tracker
OIDC_CLIENT_SECRET=not-used-in-dev
OIDC_DISCOVERY_URL=http://localhost:8000/auth/.well-known/openid-configuration
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# Application URLs
FRONTEND_URL=http://localhost:3000
WEBHOOK_URL=

# Redis (for Celery task queue)
REDIS_URL=redis://redis:6379/0

# Development mode
ENVIRONMENT=development

# Cookie settings for HTTP (not HTTPS) in development
COOKIE_SECURE=false

# SQL debugging (set to true to see all queries)
SQL_ECHO=false

# Local Authentication (Phase 35)
# When true, enables username/password login alongside OIDC
# In development, this creates test users on startup (see below)
LOCAL_AUTH_ENABLED=true

# Self-registration (only works when LOCAL_AUTH_ENABLED=true)
# SELF_REGISTRATION_ENABLED=false

# ─────────────────────────────────────────────────────────────
# Development Test Users (auto-created when LOCAL_AUTH_ENABLED=true)
# ─────────────────────────────────────────────────────────────
# Email                   Password      Role        Household
# owner@local.dev         owner123      Owner       Household A
# admin@local.dev         admin123      Admin       Household A
# caretaker@local.dev     caretaker123  Caretaker   Household A
# viewer@local.dev        viewer123     Viewer      Household A
# other@local.dev         other123      Owner       Household B (isolated)
